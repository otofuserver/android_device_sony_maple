service vendor.sensors-hal-1-0 /vendor/bin/sensors.qti
    interface android.hardware.sensors@1.0::ISensors default
    class hal
    user system
    group system input wakelock uhid context_hub
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    seclabel u:r:hal_sensors_default:s0
    rlimit rtprio 10 10