# 必要な型のみ定義（重複しないもの）
type sysfs_ssc, sysfs_type, fs_type;

# hal_sensors_default が /persist を参照できるように
allow hal_sensors_default persist_file:dir search;
allow hal_sensors_default persist_file:file { read open getattr };

# hal_sensors_default が /dev/diag にアクセスできるように
allow hal_sensors_default diag_device:chr_file { read write open ioctl };

# sensors デーモン (vendor.sensors.qti) 用
allow sensors persist_file:dir search;
allow sensors persist_file:file { read open getattr };
allow sensors diag_device:chr_file { read write open ioctl };

# init からの hal_sensors_default ドメインへの遷移許可
allow init hal_sensors_default:process { transition };
allow init sensors:process { transition };

# sensors.qti が binder や IPC 用にポートバインドできるようにする
allow hal_sensors_default self:capability net_bind_service;

# linkerconfig に sys_admin capability ���許可
#allow linkerconfig self:capability sys_admin;

# vendor_boringssl_self_test に sys_admin capability を許可
#allow vendor_boringssl_self_test self:capability sys_admin;

# fsck に sys_admin capability を許可
allow fsck self:capability sys_admin;

# tftp_server が /persist にアクセスできるよう search を許可
allow rfs_access persist_file:dir search;

# diag デバイスアクセス許可
allow qti diag_device:chr_file { read write };
allow ims diag_device:chr_file { read write };
allow netmgrd diag_device:chr_file { read write };

# /dev/sensors デバイスノードへのアクセス
allow hal_sensors_default sensors_device:chr_file { read write open ioctl };

# semc_version_prop の読み取り
allow hal_sensors_default semc_version_prop:file { read open getattr };

# tad_socket への接続
allow hal_sensors_default tad_socket:sock_file { read write open getattr };

# bind/connect は unix_stream_socket に対して許可
allow hal_sensors_default tad_socket:unix_stream_socket { connectto };

# hwbinder による通信許可
allow hal_sensors_default hwservicemanager:binder { call transfer };
allow hal_sensors_default system_server:binder { call transfer };

# プロパティアクセス（既存の型を使用）
get_prop(hal_sensors_default, vendor_sensors_prop)
set_prop(hal_sensors_default, vendor_sensors_prop)

# SLPI/SSC との通信用
allow hal_sensors_default sysfs_sensors:dir search;
allow hal_sensors_default sysfs_sensors:file { read write };
allow hal_sensors_default sysfs_ssc:dir search;
allow hal_sensors_default sysfs_ssc:file { read write open };

# 実行に必要な基本権限
allow hal_sensors_default self:process { execmem };
